{
  "name": "@scootch/art",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scootch, monsters and cards (Skia) and the pose baker",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "tsx ../../tools/scripts/generate-index.ts src/monsters src/scootch/moods src/work-modes",
    "test": "tsx ../../tools/scripts/generate-index.ts --check src/monsters src/scootch/moods src/work-modes && vitest run --passWithNoTests",
    "zoo": "tsx scripts/render-zoo.ts",
    "scootch": "tsx scripts/render-scootch.ts",
    "work-modes": "tsx scripts/render-work-modes.ts"
  },
  "dependencies": {
    "@scootch/domain": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/canvas": "catalog:",
    "@types/node": "catalog:"
  }
}
