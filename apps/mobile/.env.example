# Selects the app.config.ts variant: dev | prd | e2e-test.
# Unset means dev. EAS profiles set it in eas.json.
APP_VARIANT=dev
# Crash reporting. The DSN is a public client key; unset means crash reporting is off.
EXPO_PUBLIC_SENTRY_DSN=
# Only where symbols and source maps are uploaded (EAS and CI), never in the app.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# The public RevenueCat SDK key for iOS (starts with "appl_"). Unset means purchases are
# unavailable and every paid control says so. The secret key never goes in the app.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
