{
  "name": "@scootch/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Scootch API: Hono on Cloudflare Workers with D1 and R2",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "generate": "tsx ../../tools/scripts/generate-index.ts src/routes",
    "typecheck": "tsc --noEmit",
    "test": "tsx ../../tools/scripts/generate-index.ts --check src/routes && vitest run"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@scootch/art": "workspace:*",
    "@scootch/domain": "workspace:*",
    "@scootch/voice": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "fast-check": "catalog:",
    "vitest": "4.1.11",
    "wrangler": "catalog:"
  }
}
