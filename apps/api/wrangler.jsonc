{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two environments only: `--env dev` (Worker `phusclass-api-dev`) and `--env prd` (Worker
  // `phusclass-api`). Bindings are not inherited, so each environment declares its own. Local runs
  // and the tests use `dev` with simulated bindings, which need no Cloudflare account.
  "name": "phusclass-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The operations bot's morning digest and spend check: 08:00 in Asia/Ho_Chi_Minh, which is
  // 01:00 UTC. Cron Triggers run on UTC, and both environments inherit this one.
  "triggers": { "crons": ["0 1 * * *"] },
  // Secrets are set per environment with `wrangler secret put <NAME> --env <dev|prd>`; their names
  // are listed in `src/env.ts`. The bot needs TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID and
  // TELEGRAM_WEBHOOK_SECRET.
  "env": {
    "dev": {
      "name": "phusclass-api-dev",
      "routes": [
        { "pattern": "api-dev.phusclass.com", "zone_name": "phusclass.com", "custom_domain": true },
      ],
      // COMMIT_SHA is overridden at deploy time (`--var COMMIT_SHA:<sha>`).
      "vars": { "ENVIRONMENT": "dev", "COMMIT_SHA": "local" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "phusclass-dev",
          "database_id": "a7b0e3af-6d4c-43ae-ae37-e5d2b4504325",
          "migrations_dir": "migrations",
        },
      ],
      // Rate limit namespaces need no resource: the id is any integer unique within the account.
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "7401",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "7402",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
    "prd": {
      "name": "phusclass-api",
      // The one address the App Store app calls. A Worker with a route has no workers.dev address.
      "routes": [
        { "pattern": "api.phusclass.com", "zone_name": "phusclass.com", "custom_domain": true },
      ],
      "vars": { "ENVIRONMENT": "prd", "COMMIT_SHA": "local" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "phusclass",
          "database_id": "88e329f6-bf63-4904-abcb-df70d44a2f13",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "7411",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "7412",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
    },
  },
}
