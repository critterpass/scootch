{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two environments only: `--env dev` (Worker `scootch-dev`) and `--env prd` (Worker `scootch`).
  // Bindings are not inherited, so each environment declares its own. Local runs and the tests use
  // `dev` with simulated bindings, which need no Cloudflare account.
  "name": "scootch",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The operations bot's morning digest and spend check: 08:00 in Asia/Ho_Chi_Minh, which is
  // 01:00 UTC. Cron Triggers run on UTC, and both environments inherit this one.
  "triggers": { "crons": ["0 1 * * *"] },
  // Secrets are set per environment with `wrangler secret put <NAME> --env <dev|prd>`; their names
  // are listed in `src/env.ts`. The bot needs TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID and
  // TELEGRAM_WEBHOOK_SECRET.
  "env": {
    "dev": {
      "name": "scootch-dev",
      // COMMIT_SHA is overridden at deploy time (`--var COMMIT_SHA:<sha>`).
      "vars": { "ENVIRONMENT": "dev", "COMMIT_SHA": "local" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scootch-dev",
          "database_id": "05727e3e-154e-4128-b94f-e6100444b936",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "scootch-dev" }],
      // Rate limit namespaces need no resource: the id is any integer unique within the account.
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "7301",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "7302",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      // One Durable Object per table (`TableObject` in `src/tables/table-object.ts`).
      "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "TableObject" }] },
      "migrations": [{ "tag": "table-object", "new_sqlite_classes": ["TableObject"] }],
    },
    "prd": {
      "name": "scootch",
      // The one address the App Store app calls. A Worker with a route has no workers.dev address.
      "routes": [{ "pattern": "api.scootch.app", "custom_domain": true }],
      "vars": { "ENVIRONMENT": "prd", "COMMIT_SHA": "local" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scootch",
          "database_id": "510cc553-279d-4af3-9dee-015d0c13982a",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "scootch" }],
      "ratelimits": [
        {
          "name": "IP_RATE_LIMIT",
          "namespace_id": "7311",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "DEVICE_RATE_LIMIT",
          "namespace_id": "7312",
          "simple": { "limit": 60, "period": 60 },
        },
      ],
      // One Durable Object per table (`TableObject` in `src/tables/table-object.ts`).
      "durable_objects": { "bindings": [{ "name": "TABLE", "class_name": "TableObject" }] },
      "migrations": [{ "tag": "table-object", "new_sqlite_classes": ["TableObject"] }],
    },
  },
}
