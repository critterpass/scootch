---
import type { Language } from '@phusclass/i18n';

import { copyFor, localPath } from '../copy';

import Phu from './phu.astro';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const copy = copyFor(language).notFound;
---

<section class="not-found" lang={language}>
  <div class="wrap not-found-row">
    <Phu mood="surprised" label={copy.art} class="not-found-phu" />
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1 class="hand not-found-line">“{copy.line}”</h1>
      <p class="lede">{copy.body}</p>
      <p class="actions">
        <a class="button button-red" href={localPath(language, '/')}>{copy.home}</a>
        <a class="button button-quiet" href={localPath(language, '/support')}>{copy.support}</a>
      </p>
    </div>
  </div>
</section>
