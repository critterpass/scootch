---
import type { Language } from '@phusclass/i18n';

import { localPath, pagesFor } from '../copy';

interface Props {
  language: Language;
}

const { language } = Astro.props;
const copy = pagesFor(language).notFound;
---

<div class="not-found">
  <div class="not-found-art" aria-hidden="true">
    <span class="not-found-number">404</span>
  </div>
  <div class="not-found-words">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.headline}</h1>
    <p class="lede">{copy.body}</p>
    <div class="actions">
      <a class="button button-ink" href={localPath(language, '/')} data-magnet>{copy.home}</a>
      <a class="button button-quiet" href={localPath(language, '/help')}>{copy.help}</a>
    </div>
  </div>
</div>
