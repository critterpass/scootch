---
import type { Language } from '@phusclass/i18n';

import { appStoreUrl, copyFor, preLaunch } from '../copy';

interface Props {
  language: Language;
}

// The image is a stand-in: Apple's official badge artwork goes at this same path
// (`public/badges/download-on-the-app-store.svg`) before the site is public.
const { language } = Astro.props;
const copy = copyFor(language).badge;
---

{
  preLaunch ? (
    <p class="coming-soon" data-coming-soon>
      {copy.comingSoon}
    </p>
  ) : (
    <a class="app-store-badge" href={appStoreUrl}>
      <img src="/badges/download-on-the-app-store.svg" alt={copy.alt} width="150" height="50" />
    </a>
  )
}
