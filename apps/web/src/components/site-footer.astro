---
import type { Language } from '@phusclass/i18n';

import { copyFor, localPath } from '../copy';

interface Props {
  language: Language;
  path: `/${string}`;
}

const { language, path } = Astro.props;
const copy = copyFor(language);
const other: Language = language === 'en' ? 'vi' : 'en';
const to = (page: `/${string}`) => localPath(language, page);

const groups = [
  {
    title: copy.footer.brand,
    links: [
      { href: `${to('/help')}#isnt`, label: copy.footer.whatItIs },
      { href: to('/support'), label: copy.footer.support },
    ],
  },
  {
    title: copy.footer.help,
    links: [
      { href: to('/help'), label: copy.footer.help },
      { href: to('/helplines'), label: copy.footer.helplines },
      { href: to('/privacy'), label: copy.footer.privacy },
      { href: to('/terms'), label: copy.footer.terms },
    ],
  },
];
---

<footer class="site-footer on-night">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="logo" href={to('/')} aria-label={copy.brand.name}>{copy.brand.name}<span>.</span></a>
        <p>{copy.footer.tagline}</p>
      </div>
      {
        groups.map((group) => (
          <div class="footer-group">
            <h2>{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <div class="care-card">
        <h2>{copy.footer.hardTime}</h2>
        <p>{copy.footer.hardBody}</p>
        <a href={to('/helplines')}>{copy.footer.findHelpline}</a>
      </div>
    </div>
    <div class="footer-mark" aria-hidden="true">
      <span class="wordmark">{copy.brand.name}<span>.</span></span>
    </div>
    <div class="footer-end">
      <p>{copy.footer.supportTool}</p>
      <p>
        {copy.footer.copyright} ·
        <a href={localPath(other, path)} lang={other} hreflang={other}>{copy.footer.otherLanguage}</a>
      </p>
    </div>
  </div>
</footer>
