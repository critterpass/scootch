---
import type { Language } from '@scootch/i18n';

import { appStoreUrl, localPath, pagesFor, plainFor, preLaunch, togetherFor } from '../copy';
import { appBanner, appBannerName } from '../lib/app-links';
import { qrSvg } from '../lib/qr-code';
import SiteLayout from '../layouts/site-layout.astro';
import '../styles/together.css';

import NotFound from './not-found.astro';
import OpenInApp from './open-in-app.astro';
import RisingWords from './rising-words.astro';
import WaitlistForm from './waitlist-form.astro';

interface Props {
  language: Language;
}

// Where "Get the app" leads. On its own it is the way to the App Store: a button on a phone, a QR
// code of this page on a wide screen. "Catch it in the app" lands here with a monster's id
// (`/get?m=<id>`): the phone's button then opens the app with the monster, and the QR code is the
// monster's own link. Android and the press kit live further down.
//
// With a monster the page also carries Apple's app banner, opening the app or the App Clip on the
// monster's link. The page is prebuilt and the id is only in the address, so the tag is written
// while the head is read, before Safari looks for it.
const { language } = Astro.props;
const pages = pagesFor(language);
const copy = pages.get;
const carry = togetherFor(language).get;
const android = pages.android;
const press = plainFor(language).press;
const here = new URL(localPath(language, '/get'), Astro.site).href;
const banner = { name: appBannerName, content: appBanner, monsters: localPath(language, '/m') };
---

<SiteLayout language={language} path="/get" title={copy.title} description={copy.description}>
  <Fragment slot="head">
    {
      !preLaunch && (
        <script is:inline define:vars={{ banner }}>
          const id = new URLSearchParams(location.search).get('m') ?? '';
          if (/^[a-z0-9-]{1,40}$/.test(id)) {
            const tag = document.createElement('meta');
            tag.name = banner.name;
            tag.content = `${banner.content}, app-argument=${location.origin}${banner.monsters}/${id}`;
            document.head.append(tag);
          }
        </script>
      )
    }
  </Fragment>
  <section class="band shared-band">
    <div class="grain"></div>
    <div class="halftone get-halftone"></div>
    <div
      class="wrap shared-page"
      data-get-page
      data-state="loading"
      data-language={language}
      data-lines={JSON.stringify(carry)}
    >
      <p class="lede" data-show="loading" aria-live="polite">{carry.loading}</p>

      <div class="shared-grid" data-show="plain found" hidden>
        <div class="shared-words">
          <p class="eyebrow">{copy.eyebrow}</p>
          <div data-show="plain" hidden>
            <h1 class="rise" tabindex="-1">
              <RisingWords words={copy.words} marker />
            </h1>
          </div>
          <div data-show="found" hidden>
            <h1 tabindex="-1" data-headline></h1>
          </div>

          {
            preLaunch ? (
              <>
                <p class="lede">{copy.soonBody}</p>
                <WaitlistForm language={language} intro="" />
              </>
            ) : (
              <>
                <div class="phone-only">
                  <p class="lede" data-show="plain" hidden>{copy.phoneBody}</p>
                  <p class="lede" data-show="found" hidden>{carry.phoneBody}</p>
                  <div class="actions" data-show="plain" hidden>
                    <a class="button button-ink" href={appStoreUrl}>
                      {copy.store}
                      <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                  <div data-show="found" hidden>
                    <OpenInApp language={language} kind="m" label={carry.open} showCode={false} />
                  </div>
                </div>
                <div class="desk-only">
                  <p class="lede" data-show="plain" hidden>{copy.deskBody}</p>
                  <p class="lede" data-show="found" hidden>{carry.deskBody}</p>
                </div>
              </>
            )
          }
          <p class="small" data-show="found" hidden>
            {carry.orLink}
            <a data-link></a>
          </p>
        </div>
        {
          !preLaunch && (
            <div class="shared-art tilt-space desk-only">
              <div class="qr-card" data-lean>
                <div class="qr-code">
                  <span data-show="plain" set:html={qrSvg(here, copy.qrLabel)} hidden />
                  <img alt={carry.qrLabel} width="220" height="220" data-qr data-show="found" hidden />
                  <img class="app-icon" src="/icons/cheeky.png" alt="" width="192" height="192" />
                </div>
                <p data-show="plain" hidden>{copy.qrCaption}</p>
                <p data-show="found" hidden>{carry.deskTitle}</p>
              </div>
            </div>
          )
        }
      </div>

      <div data-show="missing" hidden>
        <NotFound language={language} focusable />
      </div>
      <div class="shared-words" data-show="offline" hidden>
        <h1 tabindex="-1">{carry.offlineTitle}</h1>
        <p class="lede">{carry.offlineBody}</p>
      </div>
    </div>
  </section>

  <section id="android" class="band turn on-night">
    <div class="grain"></div>
    <span class="turn-glow turn-glow-green"></span>
    <div class="wrap turn-grid">
      <div class="turn-words">
        <p class="eyebrow">{copy.androidEyebrow}</p>
        <h2>{copy.androidTitle}</h2>
        <p class="lede">{android.body}</p>
      </div>
      <div class="turn-form" data-reveal>
        <WaitlistForm
          language={language}
          platform="android"
          submit={android.submit}
          note={android.note}
          done={android.done}
        />
      </div>
    </div>
  </section>

  <section id="press" class="band">
    <div class="wrap stack press">
      <div class="head-pair">
        <div>
          <p class="eyebrow">{copy.pressEyebrow}</p>
          <h2>{copy.pressTitle}</h2>
        </div>
        <p class="lede">{press.intro}</p>
      </div>
      <ul class="press-cards" data-reveal="stagger">
        {
          press.sections.map((section) => (
            <li>
              <h3>{section.title}</h3>
              <p>{section.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</SiteLayout>

<script>
  import { startGetPage } from '../scripts/get-page';

  for (const root of document.querySelectorAll<HTMLElement>('[data-get-page]')) {
    void startGetPage(root);
  }
</script>
