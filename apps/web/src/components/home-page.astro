---
import type { Language } from '@phusclass/i18n';

import { copyFor, localPath } from '../copy';
import SiteLayout from '../layouts/site-layout.astro';

import AppStoreBadge from './app-store-badge.astro';

interface Props {
  language: Language;
}

// The home page: the name, one line, and the way to every other page.
const { language } = Astro.props;
const copy = copyFor(language);
const links = [
  { href: localPath(language, '/help'), label: copy.footer.help },
  { href: localPath(language, '/support'), label: copy.footer.support },
  { href: localPath(language, '/helplines'), label: copy.footer.helplines },
  { href: localPath(language, '/privacy'), label: copy.footer.privacy },
  { href: localPath(language, '/terms'), label: copy.footer.terms },
];
---

<SiteLayout language={language} path="/" title={copy.meta.title} description={copy.meta.description}>
  <article class="wrap plain">
    <h1>{copy.home.headline}</h1>
    <p class="lede">{copy.home.intro}</p>
    <AppStoreBadge language={language} />
    <h2>{copy.home.linksTitle}</h2>
    <ul class="link-list">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </article>
</SiteLayout>
