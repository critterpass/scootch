---
import type { Language } from '@scootch/i18n';

import { brand, copyFor, localPath, pagesFor, preLaunch } from '../copy';
import { scootchArt } from '../lib/drawings';

import Critter from './critter.astro';

interface Props {
  language: Language;
  path: `/${string}`;
}

const { language, path } = Astro.props;
const copy = copyFor(language);
const words = brand(language);
const home = localPath(language, '/');
const links = [
  { href: home, label: copy.nav.maker, current: path === '/' },
  { href: `${home}#hunt`, label: copy.nav.how, current: false },
  { href: `${home}#tables`, label: copy.nav.tables, current: false },
  { href: localPath(language, '/plus'), label: words.plus, current: path === '/plus' },
  { href: localPath(language, '/help'), label: copy.nav.help, current: path === '/help' },
];
// Before launch there is no app to get: the capsule leads to the maker, where the email field is.
const get = preLaunch
  ? { href: `${home}#maker`, label: pagesFor(language).preLaunch.tellMe, mark: '→' }
  : { href: localPath(language, '/get'), label: copy.nav.getTheApp, mark: '↓' };
---

<header class="site-nav">
  <div class="wrap site-nav-row">
    <a class="logo" href={home} aria-label={words.name}>scootch<span>.</span></a>
    <nav class="nav-links" aria-label={copy.nav.label}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="get-capsule" href={get.href} aria-current={path === '/get' ? 'page' : undefined} data-magnet>
      <span class="app-icon"><Critter art={scootchArt('scheming')} /></span>
      {get.label}
      <span class="dot" aria-hidden="true">{get.mark}</span>
    </a>
    <details class="nav-menu">
      <summary aria-label={copy.nav.menu}><span aria-hidden="true"></span></summary>
      <nav aria-label={copy.nav.menu}>
        {
          links.map((link) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
  <div class="scroll-line" aria-hidden="true">
    <div class="scroll-line-fill" data-scroll-fill></div>
    <div class="scroll-line-runner" data-scroll-runner>
      <Critter art={scootchArt('working')} />
    </div>
  </div>
</header>
