---
import type { Language } from '@phusclass/i18n';

import { appStoreUrl, copyFor, localPath, preLaunch, type SitePage } from '../copy';

interface Props {
  language: Language;
  path: SitePage;
}

const { language, path } = Astro.props;
const copy = copyFor(language);
const other: Language = language === 'en' ? 'vi' : 'en';
const home = localPath(language, '/');
const links = [
  { href: `${home}#loop`, label: copy.nav.loop, current: false },
  { href: localPath(language, '/tuition'), label: copy.nav.tuition, current: path === '/tuition' },
  { href: localPath(language, '/support'), label: copy.nav.support, current: path === '/support' },
];
---

<header class="site-nav">
  <div class="wrap nav-row">
    <a class="nav-brand" href={home}>
      <img src="/favicon.svg" alt="" width="36" height="36" />
      <span class="hand">{copy.brand.name}</span>
    </a>
    <nav class="nav-links" aria-label={copy.nav.label}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a
      class="nav-language"
      href={localPath(other, path)}
      lang={other}
      hreflang={other}
      aria-label={copy.nav.otherLanguageLabel}
      data-language-switch>{copy.nav.otherLanguage}</a
    >
    {
      !preLaunch && (
        <a class="button button-red nav-get" href={appStoreUrl}>
          {copy.nav.getTheApp}
        </a>
      )
    }
    <details class="nav-menu">
      <summary aria-label={copy.nav.menu}><span aria-hidden="true"></span></summary>
      <nav aria-label={copy.nav.menu}>
        {
          links.map((link) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
