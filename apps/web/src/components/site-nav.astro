---
import type { Language } from '@phusclass/i18n';

import { appStoreUrl, copyFor, localPath, preLaunch } from '../copy';

interface Props {
  language: Language;
  path: `/${string}`;
}

const { language, path } = Astro.props;
const copy = copyFor(language);
const home = localPath(language, '/');
const links = [{ href: localPath(language, '/help'), label: copy.nav.help, current: path === '/help' }];
---

<header class="site-nav">
  <div class="wrap site-nav-row">
    <a class="logo" href={home} aria-label={copy.brand.name}>{copy.brand.name}<span>.</span></a>
    <nav class="nav-links" aria-label={copy.nav.label}>
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    {
      !preLaunch && (
        <a class="get-capsule" href={appStoreUrl} data-magnet>
          {copy.nav.getTheApp}
          <span class="dot" aria-hidden="true">↓</span>
        </a>
      )
    }
    <details class="nav-menu">
      <summary aria-label={copy.nav.menu}><span aria-hidden="true"></span></summary>
      <nav aria-label={copy.nav.menu}>
        {
          links.map((link) => (
            <a href={link.href} aria-current={link.current ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
  <div class="scroll-line" aria-hidden="true">
    <div class="scroll-line-fill" data-scroll-fill></div>
  </div>
</header>
