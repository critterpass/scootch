---
import NotFound from '../components/not-found.astro';
import { pagesFor } from '../copy';
import SiteLayout from '../layouts/site-layout.astro';

// One not-found page for the whole site, in English: an address that matches nothing has no
// language to go by.
const copy = pagesFor('en').notFound;
---

<SiteLayout language="en" path="/404" title={copy.title} description={copy.body} social={false}>
  <section class="band shared-band">
    <div class="grain"></div>
    <div class="wrap shared-page">
      <NotFound language="en" />
    </div>
  </section>
</SiteLayout>
