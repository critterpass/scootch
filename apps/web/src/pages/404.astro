---
import NotFound from '../components/not-found.astro';
import { copyFor } from '../copy';
import SiteLayout from '../layouts/site-layout.astro';

// One not-found page for the whole site. It is built in English, and an address under /vi/ is
// answered in Vietnamese: the page shows one language only, chosen by the address.
const copy = copyFor('en').notFound;
const viTitle = copyFor('vi').notFound.title;
---

<SiteLayout language="en" path="/" title={copy.title} description={copy.body} social={false} chrome={false}>
  <div data-not-found="en"><NotFound language="en" /></div>
  <div data-not-found="vi" hidden><NotFound language="vi" /></div>
  <script is:inline define:vars={{ viTitle }}>
    if (location.pathname.startsWith('/vi/') || location.pathname === '/vi') {
      document.querySelector('[data-not-found="en"]').hidden = true;
      document.querySelector('[data-not-found="vi"]').hidden = false;
      document.documentElement.lang = 'vi';
      document.title = viTitle;
    }
  </script>
</SiteLayout>
