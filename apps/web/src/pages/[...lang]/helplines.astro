---
import { languagePaths, plainFor } from '../../copy';
import SiteLayout from '../../layouts/site-layout.astro';
import { VIETNAM, findAHelpline, helplineRows, type HelplineRow } from '../../lib/helplines';

export const getStaticPaths = languagePaths;
const language = Astro.params.lang === 'vi' ? 'vi' : 'en';
const copy = plainFor(language).helplines;

// No critter and no joke on this page. Vietnam comes first for a reader in Vietnamese, and its
// block ends with the directory: Vietnam has no line for adults that is open around the clock.
const find = { href: findAHelpline.href, label: findAHelpline.label };
const all = helplineRows(language);
const inVietnam = (row: HelplineRow) => row.region === VIETNAM;
const vietnam = all.filter(inVietnam);
const others = all.filter((row) => !inVietnam(row));
const directory = (country: string) => ({ country, name: findAHelpline.name, links: [find] });
const vietnamBlock = [...vietnam, directory(vietnam[0]?.country ?? '')];
const rows = [
  ...(language === 'vi' ? [...vietnamBlock, ...others] : [...others, ...vietnamBlock]),
  directory(copy.anywhere),
];
---

<SiteLayout language={language} path="/helplines" title={copy.title} description={copy.description}>
  <article class="wrap plain helplines">
    <h1>{copy.headline}</h1>
    <p class="lede">{copy.intro}</p>
    <ul class="helpline-list" data-helplines>
      {
        rows.map((row) =>
          'line' in row ? (
            <li
              data-line={row.line}
              data-country={row.region}
              data-open-detail={row.openDetail}
              data-closed-detail={row.closedDetail}
            >
              <span class="small">{row.country}</span>
              <strong>{row.name === '' ? copy.emergency : row.name}</strong>
              {row.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
              <span class="small" data-detail>
                {row.openDetail}
              </span>
            </li>
          ) : (
            <li>
              <span class="small">{row.country}</span>
              <strong>{row.name}</strong>
              {row.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </li>
          ),
        )
      }
    </ul>
    <p class="small">{copy.footnote}</p>
  </article>
</SiteLayout>

<script>
  import { keepOpenNow } from '../../scripts/helplines-open-now';

  for (const list of document.querySelectorAll<HTMLElement>('[data-helplines]')) keepOpenNow(list);
</script>
