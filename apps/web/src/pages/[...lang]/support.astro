---
import PageHead from '../../components/page-head.astro';
import { helpFor, languagePaths, localPath, pageLanguage, preLaunch } from '../../copy';
import SiteLayout from '../../layouts/site-layout.astro';

export const getStaticPaths = languagePaths;
const language = pageLanguage(Astro.params.lang);
const copy = helpFor(language).support;
---

<SiteLayout language={language} path="/support" title={copy.title} description={copy.description}>
  <PageHead eyebrow={copy.eyebrow} headline={copy.headline} lede={copy.lede} mood="think">
    <a class="button button-chalk" href={`mailto:${copy.email}`}>{copy.writeTo}: {copy.email}</a>
  </PageHead>
  <article class="wrap doc">
    {preLaunch && <p class="small">{copy.notOutYet}</p>}
    <div class="answers">
      {
        copy.questions.map((question, index) => (
          <details open={index === 0}>
            <summary>{question.q}</summary>
            <p>{question.a}</p>
          </details>
        ))
      }
    </div>
    <p class="doc-contact"><a href={localPath(language, '/helplines')}>{copy.helplinesLink}</a></p>
  </article>
</SiteLayout>
