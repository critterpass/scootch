---
import PageHead from '../../components/page-head.astro';
import { languagePaths, legalFor, pageLanguage } from '../../copy';
import SiteLayout from '../../layouts/site-layout.astro';

export const getStaticPaths = languagePaths;
const language = pageLanguage(Astro.params.lang);
const copy = legalFor(language).privacy;
---

<SiteLayout language={language} path="/privacy" title={copy.title} description={copy.description}>
  <PageHead headline={copy.headline} lede={copy.lede} mood="grading" />
  <article class="wrap doc">
    <p class="small">{copy.updated}</p>
    <h2>{copy.tableTitle}</h2>
    <div class="table-scroll">
      <table class="data-table">
        <thead>
          <tr>{copy.columns.map((column) => <th scope="col">{column}</th>)}</tr>
        </thead>
        <tbody>
          {
            copy.rows.map(([what, where, kept]) => (
              <tr>
                <th scope="row">{what}</th>
                <td data-label={copy.columns[1]}>{where}</td>
                <td data-label={copy.columns[2]}>{kept}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      copy.sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))
    }
    <p class="doc-contact"><a href="mailto:privacy@phusclass.com">{copy.contact}</a></p>
  </article>
</SiteLayout>
