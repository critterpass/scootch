{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Two environments only: `dev` (Worker `phusclass-web-dev`, on workers.dev only) and `prd`
  // (Worker `phusclass-web`, phusclass.com). The environment is chosen when the site is bundled,
  // with CLOUDFLARE_ENV=dev or CLOUDFLARE_ENV=prd; `wrangler deploy` then takes no `--env`.
  "name": "phusclass-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // Every prebuilt page answers with and without a trailing slash: `/privacy` is sent on to
  // `/privacy/`, where the page is. Stated here so that it never rests on a default.
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "auto-trailing-slash" },
  "env": {
    "dev": {
      "name": "phusclass-web-dev",
      "workers_dev": true,
    },
    "prd": {
      "name": "phusclass-web",
      "routes": [
        { "pattern": "phusclass.com", "zone_name": "phusclass.com", "custom_domain": true },
        { "pattern": "www.phusclass.com", "zone_name": "phusclass.com", "custom_domain": true },
      ],
    },
  },
}
